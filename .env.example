# ===== Zooglot.DB backend configuration =====
# Copy to .env and fill in real values. Any value left as "..." (or empty)
# keeps that integration in MOCK mode so the app still runs locally.

PORT=4000
APP_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-string

# --- Supabase (database + storage + auth) ---
SUPABASE_URL=...
SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_ANON_KEY=...

# --- Resend (transactional email: verification, magic link, reset, invites) ---
RESEND_API_KEY=...
RESEND_FROM="KOLOT CRM <crm@kolotband.co.il>"

# --- OpenAI (voice note transcription + field extraction) ---
OPENAI_API_KEY=...
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_EXTRACT_MODEL=gpt-4o-mini

# --- Google Calendar (OAuth2) ---
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/oauth/callback

# --- WhatsApp Business via OpenWA (optional; requires @open-wa/wa-automate) ---
# Band number: 055-5081080
ENABLE_WHATSAPP=false
WHATSAPP_SESSION_ID=kolot

# --- Inbound webhook security (Monday.com replacement + external forms) ---
WEBHOOK_SECRET=change-me-webhook-secret
