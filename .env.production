# Production configuration for Railway
# Copy .env.example and fill in the values below with your production secrets

PORT=3000
APP_URL=https://zooglot-backend-prod.railway.app
# Where the frontend (Vercel) actually lives — used to build public links
# (form.html, portal.html, invite/reset emails). Without this they'd point
# at this backend's own URL and 404, since the backend no longer serves the SPA.
FRONTEND_URL=https://zooglot.vercel.app

JWT_SECRET=change-me-to-a-long-random-string-for-production

# Supabase (production database)
SUPABASE_URL=...
SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_ANON_KEY=...

# Resend (production email)
RESEND_API_KEY=...
RESEND_FROM="KOLOT CRM <crm@kolotband.co.il>"

# OpenAI (voice note transcription & field extraction)
OPENAI_API_KEY=...

# Google Calendar (optional)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=https://zooglot-backend-prod.railway.app/api/calendar/oauth/callback

# WhatsApp (optional)
ENABLE_WHATSAPP=false
WHATSAPP_SESSION_ID=kolot

# Webhook security
WEBHOOK_SECRET=change-me-to-a-long-random-string-for-production
